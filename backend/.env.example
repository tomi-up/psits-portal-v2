# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/psits_v2
# Optional migration source. Keep DATABASE_URL pointed at staging.
PRODUCTION_DATABASE_URL=
# For Supabase:
# DATABASE_URL=postgresql://postgres.[project-ref]:password@aws-0-region.pooler.supabase.com:5432/postgres
# Supabase's session-mode pooler (port 5432) caps total concurrent
# connections project-wide based on your plan (free tier: 15). Keep the two
# values below under that cap so this app never triggers "max clients
# reached" on its own - see app/core/database.py.
DATABASE_POOL_SIZE=8
DATABASE_MAX_OVERFLOW=2

# Application Settings
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# Security (used only for signing internal artifacts like QR registration
# tokens - NOT for user authentication, which Supabase Auth owns)
SECRET_KEY=your-secret-key-change-in-production

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://psits.local
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*
# Comma-separated hostnames/IPs used to reach the API, such as a development
# computer's LAN address when testing the scanner on a physical phone.
TRUSTED_HOSTS=192.168.1.10

# Supabase Auth (REQUIRED - the authentication provider)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
# Server-only secret key from Supabase Project Settings > API Keys.
# Never expose this value through a VITE_ variable or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-key
# Optional when Auth and Storage use different Supabase projects.
# The server-side key above must belong to this project.
SUPABASE_STORAGE_URL=https://your-storage-project.supabase.co
SUPABASE_STORAGE_BUCKET=psits-uploads

# Email Configuration (Optional, for future notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# File Upload
MAX_FILE_SIZE=10485760
ALLOWED_EXTENSIONS=xlsx,xls,csv,jpg,jpeg,png,pdf

# Pagination
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=100

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Admin Setup (email of the account that will be granted SYSTEM_ADMIN
# after signing up via Supabase Auth)
ADMIN_EMAIL=admin@psits.local

# Features
ENABLE_STUDENT_IMPORT=True
ENABLE_NOTIFICATIONS=True
ENABLE_AUDIT_LOGS=True
